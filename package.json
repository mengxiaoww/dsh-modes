{
  "name": "dsh-modes",
  "version": "0.1.0",
  "description": "Independent normal-task modes for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./guidance": "./lib/guidance.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/preset.js && node --check lib/guidance.js"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  },
